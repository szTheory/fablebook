#!/usr/bin/env elixir

defmodule Fablebook.BrandSourceFetcher do
  @moduledoc false

  @repo_root Path.expand("..", __DIR__)
  @lock_path Path.join(@repo_root, "brand_sources.lock.json")
  @cache_root Path.join([@repo_root, ".cache", "brand_sources"])
  @lock_schema "fablebook-brand-sources/v1"
  @required_names ~w(fablebook-brand logistify-brand chatly-brand clinicly-brand shopadelic-brand finanza-brand classwell-brand)

  def main do
    try do
      result = dispatch(System.argv())
      IO.puts(result)
    rescue
      error in [RuntimeError, ArgumentError] ->
        IO.puts(:stderr, "brand source fetch blocked: #{Exception.message(error)}")
        System.halt(1)
    end
  end

  defp dispatch([]), do: fetch_all(load_lock())
  defp dispatch(["--update", name]), do: update_lock(name, nil)
  defp dispatch(["--update", name, tag]), do: update_lock(name, tag)
  defp dispatch(["--self-test"]), do: self_test()
  defp dispatch(["--help"]), do: usage()

  defp dispatch(_args) do
    raise ArgumentError,
          "usage: bin/fetch_brand_sources [--update NAME [TAG] | --self-test | --help]"
  end

  defp usage do
    "usage: bin/fetch_brand_sources [--update NAME [TAG] | --self-test | --help]"
  end

  defp load_lock do
    bytes =
      case File.read(@lock_path) do
        {:ok, bytes} -> bytes
        {:error, reason} -> raise "cannot read brand source lock: #{:file.format_error(reason)}"
      end

    lock =
      try do
        :json.decode(bytes)
      rescue
        _ -> raise "brand source lock is not valid JSON"
      end

    validate_lock!(lock)
  end

  defp validate_lock!(%{"schema" => @lock_schema, "books" => books} = lock)
       when is_list(books) and books != [] do
    names = Enum.map(books, &validate_book!/1)

    if length(names) != MapSet.size(MapSet.new(names)) do
      raise "brand source lock contains duplicate names"
    end

    unless names == @required_names do
      raise "brand source lock must contain the seven approved books in canonical order"
    end

    lock
  end

  defp validate_lock!(_lock), do: raise("brand source lock schema or book list is invalid")

  defp validate_book!(%{
         "name" => name,
         "clone_url" => clone_url,
         "tag" => tag,
         "commit" => commit
       } = book) do
    expected_keys = ["clone_url", "commit", "name", "tag"]

    if Enum.sort(Map.keys(book)) != expected_keys do
      raise "brand source lock entry has unexpected fields"
    end

    unless is_binary(name) and Regex.match?(~r/\A[a-z0-9]+(?:-[a-z0-9]+)*\z/, name) do
      raise "brand source lock has an invalid name"
    end

    unless clone_url == "https://github.com/szTheory/#{name}.git" do
      raise "brand source lock has an unexpected clone URL for #{name}"
    end

    unless is_binary(tag) and Regex.match?(~r/\Av[0-9]+\.[0-9]+(?:\.[0-9]+)?(?:-[0-9A-Za-z.-]+)?\z/, tag) do
      raise "brand source lock has an invalid tag for #{name}"
    end

    unless is_binary(commit) and Regex.match?(~r/\A[0-9a-f]{40}\z/, commit) do
      raise "brand source lock has an invalid full commit SHA for #{name}"
    end

    name
  end

  defp validate_book!(_book), do: raise("brand source lock entry is incomplete")

  defp fetch_all(%{"books" => books}) do
    File.mkdir_p!(@cache_root)

    books
    |> Enum.map(fn book ->
      case ensure_source(book, @cache_root) do
        {:cached, _path} -> "#{book["name"]}: already pinned"
        {:fetched, _path} -> "#{book["name"]}: fetched #{book["commit"]}"
      end
    end)
    |> Enum.join("\n")
  end

  defp ensure_source(book, cache_root) do
    name = book["name"]
    path = Path.join(cache_root, name)
    prepare_cache_path!(path, name)
    ensure_repo!(path, book["clone_url"], name)
    ensure_clean_cache!(path, name)
    expected_commit = book["commit"]

    case current_commit(path) do
      {:ok, ^expected_commit} ->
        {:cached, path}

      _ ->
        git!(path, ["fetch", "--depth", "1", "origin", book["commit"]])
        git!(path, ["checkout", "--detach", book["commit"]])

        actual = git!(path, ["rev-parse", "HEAD"])

        unless actual == book["commit"] do
          raise "#{name}: checked out #{actual}, expected #{book["commit"]}"
        end

        {:fetched, path}
    end
  end

  defp prepare_cache_path!(path, name) do
    case File.lstat(path) do
      {:error, :enoent} ->
        File.mkdir_p!(path)
        git!(nil, ["init", "--quiet", path])

      {:ok, %{type: :directory}} ->
        entries = File.ls!(path)

        cond do
          File.dir?(Path.join(path, ".git")) ->
            :ok

          entries == [] ->
            git!(nil, ["init", "--quiet", path])

          true ->
            raise "#{name}: cache path exists but is not a Git repository"
        end

      {:ok, _stat} ->
        raise "#{name}: cache path is not a directory"
    end
  end

  defp ensure_repo!(path, clone_url, name) do
    remotes = git!(path, ["remote"]) |> String.split("\n", trim: true)

    case remotes do
      [] ->
        git!(path, ["remote", "add", "origin", clone_url])

      ["origin"] ->
        actual_url = git!(path, ["remote", "get-url", "origin"])

        unless actual_url == clone_url do
          raise "#{name}: cache origin does not match the locked clone URL"
        end

      _ ->
        raise "#{name}: cache has unexpected Git remotes"
    end
  end

  defp ensure_clean_cache!(path, name) do
    status = git!(path, ["status", "--porcelain", "--untracked-files=all"])

    if status != "" do
      raise "#{name}: cache has local changes; refusing to overwrite it"
    end
  end

  defp current_commit(path) do
    case git(path, ["rev-parse", "--verify", "HEAD"]) do
      {:ok, commit} -> {:ok, commit}
      {:error, _message} -> :none
    end
  end

  defp update_lock(name, requested_tag) do
    lock = load_lock()

    case Enum.find(lock["books"], &(&1["name"] == name)) do
      nil ->
        raise "unknown brand source: #{name}"

      book ->
        tag = requested_tag || book["tag"]

        unless Regex.match?(~r/\Av[0-9]+\.[0-9]+(?:\.[0-9]+)?(?:-[0-9A-Za-z.-]+)?\z/, tag) do
          raise "invalid version tag: #{tag}"
        end

        commit = resolve_tag!(book["clone_url"], tag)

        if book["tag"] == tag and book["commit"] == commit do
          "#{name}: #{tag} already pins #{commit}; lock unchanged"
        else
          books =
            Enum.map(lock["books"], fn entry ->
              if entry["name"] == name do
                Map.put(entry, "tag", tag) |> Map.put("commit", commit)
              else
                entry
              end
            end)

          updated = Map.put(lock, "books", books)
          write_lock!(updated)
          "#{name}: updated to #{tag} at #{commit}; review the lock diff"
        end
    end
  end

  defp resolve_tag!(clone_url, tag) do
    direct_ref = "refs/tags/#{tag}"
    peeled_ref = "#{direct_ref}^{}"
    output = git_output!(nil, ["ls-remote", "--tags", clone_url, direct_ref, peeled_ref])

    refs =
      output
      |> String.split("\n", trim: true)
      |> Enum.map(fn line ->
        case String.split(line, "\t", parts: 2) do
          [sha, ref] -> {ref, sha}
          _ -> raise "git ls-remote returned malformed output for #{tag}"
        end
      end)
      |> Map.new()

    commit = Map.get(refs, peeled_ref) || Map.get(refs, direct_ref)

    unless is_binary(commit) and Regex.match?(~r/\A[0-9a-f]{40}\z/, commit) do
      raise "tag #{tag} does not resolve to a full commit SHA in #{clone_url}"
    end

    commit
  end

  defp write_lock!(lock) do
    books =
      lock["books"]
      |> Enum.map(fn book ->
        "    { \"name\": #{json!(book["name"])}, \"clone_url\": #{json!(book["clone_url"])}, \"tag\": #{json!(book["tag"])}, \"commit\": #{json!(book["commit"])} }"
      end)
      |> Enum.join(",\n")

    bytes = "{\n  \"schema\": #{json!(@lock_schema)},\n  \"books\": [\n#{books}\n  ]\n}\n"
    temporary = @lock_path <> ".tmp-#{System.unique_integer([:positive])}"
    File.write!(temporary, bytes, [:binary, :exclusive])
    File.rename!(temporary, @lock_path)
  end

  defp json!(value), do: :json.encode(value) |> IO.iodata_to_binary()

  defp git!(path, args) do
    case git(path, args) do
      {:ok, output} -> output
      {:error, reason} -> raise reason
    end
  end

  defp git_output!(path, args) do
    case run_git(path, args) do
      {output, 0} -> String.trim(output)
      {output, status} -> raise "git #{Enum.join(args, " ")} failed (#{status}): #{String.trim(output)}"
    end
  end

  defp git(path, args) do
    case run_git(path, args) do
      {output, 0} -> {:ok, String.trim(output)}
      {output, status} -> {:error, "git #{Enum.join(args, " ")} failed (#{status}): #{String.trim(output)}"}
    end
  end

  defp run_git(nil, args), do: System.cmd("git", args, stderr_to_stdout: true)
  defp run_git(path, args), do: System.cmd("git", ["-C", path | args], stderr_to_stdout: true)

  defp self_test do
    parent = Path.join(System.tmp_dir!(), "fablebook-brand-fetch-#{System.unique_integer([:positive])}")
    remote = Path.join(parent, "remote.git")
    source = Path.join(parent, "source")
    cache = Path.join(parent, "cache")

    try do
      test_lock = %{
        "schema" => @lock_schema,
        "books" => Enum.map(@required_names, fn name ->
          %{
            "name" => name,
            "clone_url" => "https://github.com/szTheory/#{name}.git",
            "tag" => "v1.0",
            "commit" => String.duplicate("a", 40)
          }
        end)
      }

      assert_equal(validate_lock!(test_lock), test_lock, "complete source lock")
      assert_fails(fn -> validate_lock!(Map.update!(test_lock, "books", &Enum.drop(&1, -1))) end, "missing locked book")

      File.mkdir_p!(parent)
      git!(nil, ["init", "--quiet", "--bare", remote])
      git!(nil, ["init", "--quiet", source])
      File.write!(Path.join(source, "README.md"), "first\n")
      git!(source, ["add", "README.md"])
      git!(source, ["-c", "user.name=Fablebook", "-c", "user.email=fablebook-test", "commit", "--quiet", "-m", "first"])
      first_commit = git!(source, ["rev-parse", "HEAD"])
      git!(source, ["tag", "v1.0"])
      git!(source, ["remote", "add", "origin", remote])
      git!(source, ["push", "--quiet", "origin", "refs/tags/v1.0"])

      first = %{"name" => "self-test-brand", "clone_url" => remote, "tag" => "v1.0", "commit" => first_commit}
      {:fetched, cache_path} = ensure_source(first, cache)
      assert_equal(git!(cache_path, ["rev-parse", "HEAD"]), first_commit, "full commit fetch")
      assert_equal(git!(cache_path, ["rev-parse", "--abbrev-ref", "HEAD"]), "HEAD", "detached checkout")
      assert_equal(resolve_tag!(remote, "v1.0"), first_commit, "lightweight tag resolution")
      assert_fails(fn -> ensure_source(%{first | "clone_url" => remote <> ".wrong"}, cache) end, "wrong origin refusal")

      wrong_pin = %{first | "commit" => String.duplicate("0", 40)}
      assert_fails(fn -> ensure_source(wrong_pin, cache) end, "wrong commit refusal")

      offline_remote = remote <> ".offline"
      File.rename!(remote, offline_remote)
      {:cached, _cache_path} = ensure_source(first, cache)
      File.rename!(offline_remote, remote)

      File.write!(Path.join(source, "README.md"), "second\n")
      git!(source, ["add", "README.md"])
      git!(source, ["-c", "user.name=Fablebook", "-c", "user.email=fablebook-test", "commit", "--quiet", "-m", "second"])
      second_commit = git!(source, ["rev-parse", "HEAD"])
      git!(source, ["tag", "-a", "v1.1", "-m", "second"])
      git!(source, ["push", "--quiet", "origin", "refs/tags/v1.1"])
      assert_equal(resolve_tag!(remote, "v1.1"), second_commit, "annotated tag resolution")

      second = %{first | "tag" => "v1.1", "commit" => second_commit}
      {:fetched, second_path} = ensure_source(second, cache)
      assert_equal(git!(second_path, ["rev-parse", "HEAD"]), second_commit, "updated commit fetch")

      File.write!(Path.join(second_path, "README.md"), "dirty\n")
      assert_fails(fn -> ensure_source(second, cache) end, "dirty cache refusal")

      "brand source fetcher self-test: full-SHA fetch, detached checkout, network-free cache hit, lightweight and annotated tags, and dirty-cache refusal passed"
    after
      File.rm_rf(parent)
    end
  end

  defp assert_equal(value, value, _label), do: :ok
  defp assert_equal(_actual, _expected, label), do: raise("#{label} self-test failed")

  defp assert_fails(fun, label) do
    try do
      fun.()
      raise "#{label} was accepted"
    rescue
      error in RuntimeError ->
        if String.contains?(Exception.message(error), "was accepted") do
          reraise error, __STACKTRACE__
        end

        :ok
    end
  end
end

Fablebook.BrandSourceFetcher.main()
